{
  "id": "doodle-gpu",
  "kind": "tool",
  "version": "2.1.1",
  "title": "Doodle Jump GPU support",
  "description": "Draws Doodle Jump into compositor GPU buffers",
  "mguHmi": [
    "ID7"
  ],
  "optional": true,
  "uninstallable": true,
  "requires": {
    "mgu-render": "0.6.26"
  },
  "files": [
    {
      "path": "doodle-gpu",
      "from": "build/target/doodle-gpu",
      "mode": "0755"
    },
    {
      "path": "LICENSE",
      "mode": "0644"
    },
    {
      "path": "LICENSE.mgu-renderd",
      "mode": "0644"
    },
    {
      "path": "gpu_check.js",
      "mode": "0644"
    },
    {
      "path": "LICENSE.ivi",
      "mode": "0644"
    }
  ],
  "restart": [
    "doodle-gpu.service"
  ],
  "check": [
    "gpu_check.js"
  ],
  "units": [
    {
      "name": "doodle-gpu.socket",
      "from": "systemd/doodle-gpu.socket"
    },
    {
      "name": "doodle-gpu.service",
      "from": "systemd/doodle-gpu.service"
    }
  ],
  "enable": [
    {
      "unit": "doodle-gpu.socket",
      "target": "sockets.target"
    }
  ]
}
