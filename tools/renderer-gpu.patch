+/* A driver refusing the optional game shaders must leave ordinary apps usable. */
+#include <EGL/egl.h>
+#include <GLES2/gl2.h>
+#include <stdio.h>
+#include "gfx.h"
+#include "proto.h"
+
+void __real_glGetShaderiv(GLuint shader, GLenum pname, GLint *params);
+void __wrap_glGetShaderiv(GLuint shader, GLenum pname, GLint *params) {
+    static int failures=2;
+    __real_glGetShaderiv(shader,pname,params);
+    if (pname==GL_COMPILE_STATUS && failures>0) { failures--; *params=GL_FALSE; }
+}
+int main(void) {
+    EGLDisplay d=eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    EGLint ca[]={EGL_SURFACE_TYPE,EGL_PBUFFER_BIT,EGL_RENDERABLE_TYPE,EGL_OPENGL_ES2_BIT,EGL_NONE}, n;
+    EGLint xa[]={EGL_CONTEXT_CLIENT_VERSION,2,EGL_NONE}, pa[]={EGL_WIDTH,16,EGL_HEIGHT,16,EGL_NONE};
+    EGLConfig cfg;
+    if (!eglInitialize(d,NULL,NULL)||!eglChooseConfig(d,ca,&cfg,1,&n)||n<1) return 1;
+    eglBindAPI(EGL_OPENGL_ES_API);
+    EGLContext ctx=eglCreateContext(d,cfg,EGL_NO_CONTEXT,xa);
+    EGLSurface pb=eglCreatePbufferSurface(d,cfg,pa);
+    if (!eglMakeCurrent(d,pb,pb,ctx)) return 1;
+    if (gfx_init()<0 || gfx_scene_supported()) { puts("FAIL scene shader failure broke renderer initialization"); return 1; }
+    gfx_client c={0}; gfx_xf xf={1,0,0};
+    const uint32_t green[]={OP_CLEAR,0x00ff00ff};
+    uint8_t p[4]; gfx_draw(&c,&xf,16,16,green,2,GFX_CLEAR);
+    glReadPixels(8,8,1,1,GL_RGBA,GL_UNSIGNED_BYTE,p);
+    const uint32_t empty[]={16,16};
+    int good=p[0]<10 && p[1]>245 && p[2]<10 &&
+        gfx_scene_frame(&c,(const uint8_t *)empty,sizeof empty)<0 && glGetError()==GL_NO_ERROR;
+    gfx_client_free(&c);
+    puts(good ? "scene shader fallback: all ok" : "FAIL scene shader fallback"); return !good;
+}
