+++ b/native/mgu-render/test/test_scene.c
@@ -0,0 +1,190 @@
+/* Original GLES scene commands, rendered through the public gfx API on Mesa. */
+#include <EGL/egl.h>
+#include <GLES2/gl2.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "gfx.h"
+#include "proto.h"
+
+static int fails;
+#define CHECK(c, msg) do { printf("%s %s\n", (c) ? "ok" : (fails++, "FAIL"), msg); } while (0)
+static uint32_t fp(float f) { uint32_t n; memcpy(&n, &f, 4); return n; }
+static uint8_t px[16 * 16 * 4];
+static uint32_t cmd[2048];
+static size_t used;
+static int refuse_framebuffer;
+GLenum __real_glCheckFramebufferStatus(GLenum target);
+GLenum __wrap_glCheckFramebufferStatus(GLenum target) {
+    return refuse_framebuffer ? GL_FRAMEBUFFER_UNSUPPORTED : __real_glCheckFramebufferStatus(target);
+}
+static void clear(float r, float g, float b, float a) {
+    cmd[used++] = 1;
+    cmd[used++] = fp(r); cmd[used++] = fp(g); cmd[used++] = fp(b); cmd[used++] = fp(a);
+}
+static void quad(uint32_t tex, uint32_t flags, uint32_t src, uint32_t dst, uint32_t replace,
+                 const float *xy, float umax, float vmax, float r, float g, float b, float a) {
+    const unsigned ix[] = {0, 1, 2, 2, 1, 3};
+    const float uv[] = {0, 0, umax, 0, 0, vmax, umax, vmax};
+    cmd[used++] = 2; cmd[used++] = tex; cmd[used++] = flags;
+    cmd[used++] = src; cmd[used++] = dst; cmd[used++] = replace; cmd[used++] = 6;
+    for (int i = 0; i < 6; i++) {
+        unsigned k = ix[i];
+        const float v[] = {xy[k*2], xy[k*2+1], uv[k*2], uv[k*2+1], r, g, b, a};
+        for (int j = 0; j < 8; j++) cmd[used++] = fp(v[j]);
+    }
+}
+static int scene(gfx_client *c) {
+    uint32_t payload[2050] = {16, 16};
+    memcpy(payload + 2, cmd, used * 4);
+    return gfx_scene_frame(c, (uint8_t *)payload, (used + 2) * 4);
+}
+static void draw(gfx_client *c) {
+    const uint32_t frame[] = {OP_SCENE, fp(0), fp(0), fp(16), fp(16), 1,
+                             OP_RECT, fp(14), fp(14), fp(2), fp(2), 0x00ff00ff};
+    gfx_xf xf = {1, 0, 0};
+    gfx_draw(c, &xf, 16, 16, frame, sizeof frame / 4, GFX_CLEAR);
+    glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE, px);
+}
+static const uint8_t *pixel(int x, int y) { return px + ((15-y)*16+x)*4; }
+static int color(int x, int y, int r, int g, int b, int a, int tolerance) {
+    const uint8_t *p = pixel(x, y);
+    return abs(p[0]-r)<=tolerance && abs(p[1]-g)<=tolerance && abs(p[2]-b)<=tolerance && abs(p[3]-a)<=tolerance;
+}
+static int upload(gfx_client *c, uint32_t id, int w, int h, const uint8_t *data) {
+    size_t n = 12 + (size_t)w*h*4;
+    uint8_t *p = calloc(1, n);
+    uint32_t head[] = {id, w, h}; memcpy(p, head, 12);
+    if (w && h) memcpy(p+12, data, n-12);
+    int r = gfx_scene_texture(c, p, n); free(p); return r;
+}
+int main(void) {
+    EGLDisplay d = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    EGLint ca[] = {EGL_SURFACE_TYPE,EGL_PBUFFER_BIT,EGL_RENDERABLE_TYPE,EGL_OPENGL_ES2_BIT,
+                   EGL_RED_SIZE,8,EGL_GREEN_SIZE,8,EGL_BLUE_SIZE,8,EGL_ALPHA_SIZE,8,EGL_NONE}, n;
+    EGLint xa[] = {EGL_CONTEXT_CLIENT_VERSION,2,EGL_NONE}, pa[] = {EGL_WIDTH,16,EGL_HEIGHT,16,EGL_NONE};
+    EGLConfig cfg;
+    if (!eglInitialize(d, NULL, NULL) || !eglChooseConfig(d, ca, &cfg, 1, &n) || n<1) return 1;
+    eglBindAPI(EGL_OPENGL_ES_API);
+    EGLContext ctx = eglCreateContext(d,cfg,EGL_NO_CONTEXT,xa);
+    EGLSurface pb = eglCreatePbufferSurface(d,cfg,pa);
+    if (!eglMakeCurrent(d,pb,pb,ctx) || gfx_init()<0) return 1;
+    gfx_client c = {0};
+    const float whole[] = {0,0,16,0,0,16,16,16};
+    const uint8_t tex[] = {255,0,0,255, 0,255,0,255, 0,0,255,255, 255,255,255,255};
+    CHECK(!upload(&c,1,2,2,tex), "scene texture uploads");
+    used=0; clear(0,0,0,1); quad(1,0,1,0,0,whole,1,1,1,1,1,1);
+    CHECK(!scene(&c), "textured scene is accepted"); draw(&c);
+    CHECK(color(2,2,255,0,0,255,0) && color(12,2,0,255,0,255,0) && color(2,12,0,0,255,255,0),
+          "texture UVs and FBO orientation stay top-down");
+    CHECK(color(15,15,0,255,0,255,0), "ordinary renderer drawing after a scene keeps its state");
+    used=0; clear(0,0,0,1); quad(1,0,1,0,0,whole,1,1,.5,1,1,.5);
+    CHECK(!scene(&c), "modulated scene accepted"); draw(&c);
+    CHECK(color(2,2,128,0,0,128,1), "vertex color modulates texture RGB and alpha");
+    used=0; clear(0,0,0,1); quad(1,0,1,0,1,whole,1,1,0,0,0,0);
+    CHECK(!scene(&c), "replace scene accepted"); draw(&c);
+    CHECK(color(2,2,255,0,0,255,0), "replace keeps texture color despite vertex color");
+    used=0; clear(0,0,0,1); quad(1,0,1,0,2,whole,1,1,0,1,0,.5);
+    CHECK(!scene(&c), "overlay scene accepted"); draw(&c);
+    CHECK(color(2,2,128,128,0,255,1), "overlay combines vertex RGB and keeps texture alpha");
+    used=0; clear(0,0,1,1); quad(0,1,770,771,0,whole,1,1,1,0,0,.5);
+    CHECK(!scene(&c), "alpha blend scene accepted"); draw(&c);
+    CHECK(color(2,2,128,0,128,191,1), "original source-alpha blend factors affect RGBA");
+    used=0; clear(0,0,0,1); quad(1,2,1,0,0,whole,1,1,1,1,1,1);
+    CHECK(!scene(&c), "linear filter scene accepted"); draw(&c);
+    CHECK(color(7,7,129,112,112,255,2), "bilinear filtering mixes the four neighboring texels");
+    const uint8_t stripe[] = {255,0,0,255, 0,255,0,255, 0,0,255,255};
+    CHECK(!upload(&c,2,3,1,stripe), "non-power-of-two texture uploads");
+    used=0; clear(0,0,0,1); quad(2,4,1,0,0,whole,2,1,1,1,1,1);
+    CHECK(!scene(&c), "repeating NPOT texture accepted"); draw(&c);
+    CHECK(color(0,4,255,0,0,255,0) && color(8,4,255,0,0,255,0), "repeat works for non-power-of-two textures");
+    const float diamond[] = {8,0,16,8,0,8,8,16};
+    used=0; clear(0,0,0,1); quad(1,0,1,0,0,diamond,1,1,1,1,1,1);
+    CHECK(!scene(&c), "rotated textured mesh accepted"); draw(&c);
+    CHECK(color(0,0,0,0,0,255,0) && color(8,2,255,0,0,255,0), "rotated mesh uses its geometry rather than bounding rectangle");
+    uint32_t bad[] = {16,16,1,fp(NAN),0,0,0};
+    CHECK(gfx_scene_frame(&c,(uint8_t *)bad,sizeof bad)<0, "nonfinite scene is rejected");
+    CHECK(gfx_scene_frame(&c,(uint8_t *)bad,9)<0, "unaligned scene is rejected");
+    bad[3]=0; bad[0]=2049;
+    CHECK(gfx_scene_frame(&c,(uint8_t *)bad,sizeof bad)<0, "oversized scene is rejected");
+    uint32_t short_draw[] = {16,16,2,1,0,1,0,0,65535};
+    CHECK(gfx_scene_frame(&c,(uint8_t *)short_draw,sizeof short_draw)<0, "truncated vertices are rejected");
+    const uint32_t invalid[][6] = {{1,16,1,0,0,0}, {1,0,769,0,0,0}, {1,0,1,769,0,0},
+                                   {1,0,1,0,3,0}, {1,0,1,0,0,4}, {1,0,1,0,0,65538}};
+    int valid=1;
+    for (unsigned i=0;i<sizeof invalid/sizeof *invalid;i++) {
+        uint32_t p[9]={16,16,2}; memcpy(p+3,invalid[i],sizeof invalid[i]);
+        valid &= gfx_scene_frame(&c,(uint8_t *)p,sizeof p)<0;
+    }
+    CHECK(valid, "invalid flags, blend functions, replacement and triangle counts are rejected");
+    uint32_t unknown[] = {16,16,3};
+    CHECK(gfx_scene_frame(&c,(uint8_t *)unknown,sizeof unknown)<0, "unknown scene commands are rejected");
+    uint32_t bad_texture[] = {1,0,1};
+    CHECK(gfx_scene_texture(&c,(uint8_t *)bad_texture,sizeof bad_texture)<0, "one zero texture dimension is rejected");
+    bad_texture[1]=2049;
+    CHECK(gfx_scene_texture(&c,(uint8_t *)bad_texture,sizeof bad_texture)<0, "oversized textures are rejected");
+    bad_texture[1]=1;
+    CHECK(gfx_scene_texture(&c,(uint8_t *)bad_texture,sizeof bad_texture)<0, "short texture pixels are rejected");
+    draw(&c); CHECK(color(8,2,255,0,0,255,0), "a malformed frame keeps the last valid scene");
+    CHECK(!upload(&c,1,0,0,NULL), "texture deletion succeeds");
+    draw(&c); CHECK(color(8,2,255,0,0,255,0) && glGetError()==GL_NO_ERROR, "cached scene stays visible after source textures are deleted");
+    used=0; clear(0,0,1,1); quad(1,0,1,0,0,whole,1,1,1,1,1,1);
+    CHECK(!scene(&c), "a scene with a missing texture is accepted safely"); draw(&c);
+    CHECK(color(8,2,0,0,255,255,0), "missing textures leave the scene clear color");
+    used=0; clear(1,0,0,1); CHECK(!scene(&c), "clear-only scene accepted");
+    const uint32_t clipped[] = {OP_CLEAR,0x0000ffff, OP_CLIP,fp(2),fp(3),fp(5),fp(7),
+                               OP_ALPHA,fp(.5), OP_SCENE,fp(0),fp(0),fp(16),fp(16),2,
+                               OP_ALPHA,fp(1),OP_NOCLIP, OP_RECT,fp(14),fp(14),fp(2),fp(2),0x00ff00ff};
+    gfx_xf xf={1,0,0};
+    gfx_draw(&c,&xf,16,16,clipped,sizeof clipped/4,GFX_CLEAR);
+    glReadPixels(0,0,16,16,GL_RGBA,GL_UNSIGNED_BYTE,px);
+    CHECK(color(3,4,128,0,128,255,1) && color(1,4,0,0,255,255,0) && color(8,4,0,0,255,255,0),
+          "scene composition preserves the caller's clip and global alpha");
+    CHECK(color(15,15,0,255,0,255,0), "drawing after clipped scene keeps renderer state");
+    const uint32_t positioned[] = {OP_CLEAR,0x0000ffff, OP_SCENE,fp(0),fp(0),fp(16),fp(16),3};
+    xf=(gfx_xf){.5,4,2};
+    gfx_draw(&c,&xf,16,16,positioned,sizeof positioned/4,GFX_CLEAR);
+    glReadPixels(0,0,16,16,GL_RGBA,GL_UNSIGNED_BYTE,px);
+    CHECK(color(4,2,255,0,0,255,0) && color(11,9,255,0,0,255,0) && color(3,2,0,0,255,255,0),
+          "scene composition follows the renderer placement transform");
+    gfx_client_free(&c);
+    CHECK(glGetError()==GL_NO_ERROR, "scene resources free without GL errors");
+    gfx_client unavailable={0};
+    used=0; clear(1,0,0,1); refuse_framebuffer=1;
+    int failure=scene(&unavailable); refuse_framebuffer=0;
+    CHECK(failure==-2 && !strncmp(gfx_error(),"scene GPU:",10), "GPU framebuffer failure is distinguished from a malformed message");
+    const uint32_t green[]={OP_CLEAR,0x00ff00ff}; xf=(gfx_xf){1,0,0};
+    gfx_draw(&unavailable,&xf,16,16,green,2,GFX_CLEAR);
+    glReadPixels(0,0,16,16,GL_RGBA,GL_UNSIGNED_BYTE,px);
+    CHECK(color(2,2,0,255,0,255,0) && glGetError()==GL_NO_ERROR, "framebuffer failure leaves ordinary drawing available");
+    gfx_client_free(&unavailable);
+    gfx_client state={0}; GLuint textures[2], buffer;
+    glGenTextures(2,textures); glActiveTexture(GL_TEXTURE0); glBindTexture(GL_TEXTURE_2D,textures[0]);
+    glActiveTexture(GL_TEXTURE3); glBindTexture(GL_TEXTURE_2D,textures[1]);
+    glGenBuffers(1,&buffer); glBindBuffer(GL_ARRAY_BUFFER,buffer); glBufferData(GL_ARRAY_BUFFER,64,NULL,GL_STATIC_DRAW);
+    glVertexAttribPointer(0,3,GL_FLOAT,GL_TRUE,12,(void *)4); glEnableVertexAttribArray(0); glDisableVertexAttribArray(1);
+    glViewport(1,2,10,11); glEnable(GL_SCISSOR_TEST); glScissor(2,3,4,5); glEnable(GL_DEPTH_TEST); glEnable(GL_CULL_FACE);
+    glBlendFuncSeparate(GL_DST_ALPHA,GL_ONE,GL_ZERO,GL_ONE_MINUS_SRC_ALPHA);
+    glBlendEquationSeparate(GL_FUNC_REVERSE_SUBTRACT,GL_FUNC_SUBTRACT);
+    glClearColor(.125,.25,.5,.75); glColorMask(GL_TRUE,GL_FALSE,GL_TRUE,GL_FALSE);
+    GLint old_program; glGetIntegerv(GL_CURRENT_PROGRAM,&old_program);
+    used=0; clear(.25,.5,.75,1); CHECK(!scene(&state), "a scene renders between arbitrary caller GL state");
+    GLint viewport[4], active, binding, function, equation, size, stride, program; GLboolean mask[4]; void *pointer;
+    glGetIntegerv(GL_VIEWPORT,viewport); glGetIntegerv(GL_ACTIVE_TEXTURE,&active); glGetIntegerv(GL_TEXTURE_BINDING_2D,&binding);
+    glGetIntegerv(GL_BLEND_SRC_RGB,&function); glGetIntegerv(GL_BLEND_EQUATION_ALPHA,&equation);
+    glGetVertexAttribiv(0,GL_VERTEX_ATTRIB_ARRAY_SIZE,&size); glGetVertexAttribiv(0,GL_VERTEX_ATTRIB_ARRAY_STRIDE,&stride);
+    glGetVertexAttribPointerv(0,GL_VERTEX_ATTRIB_ARRAY_POINTER,&pointer); glGetIntegerv(GL_CURRENT_PROGRAM,&program);
+    glGetBooleanv(GL_COLOR_WRITEMASK,mask);
+    CHECK(viewport[0]==1 && viewport[1]==2 && viewport[2]==10 && viewport[3]==11 && active==GL_TEXTURE3 &&
+          binding==(GLint)textures[1] && function==GL_DST_ALPHA && equation==GL_FUNC_SUBTRACT &&
+          size==3 && stride==12 && pointer==(void *)4 && program==old_program && glIsEnabled(GL_SCISSOR_TEST) &&
+          glIsEnabled(GL_DEPTH_TEST) && glIsEnabled(GL_CULL_FACE) && mask[0] && !mask[1] && mask[2] && !mask[3],
+          "scene rendering restores viewport, texture unit, blending, attributes, enables and color mask");
+    glDisable(GL_CULL_FACE); glColorMask(GL_TRUE,GL_TRUE,GL_TRUE,GL_TRUE); glBlendEquation(GL_FUNC_ADD);
+    glActiveTexture(GL_TEXTURE0); glBindBuffer(GL_ARRAY_BUFFER,0);
+    draw(&state);
+    CHECK(color(2,2,64,128,191,255,1), "scene rendering writes every channel regardless of caller color mask");
+    gfx_client_free(&state); glDeleteBuffers(1,&buffer); glDeleteTextures(2,textures);
+    puts(fails ? "FAILURES" : "scene: all ok"); return fails!=0;
+}
